# Copy to .env. Everything here is real: deposits are verified on-chain, payouts are real USDC transfers.
PORT=8402
STATE_FILE=./data/mint.json   # holds the mint's PRIVATE KEYS: keep it out of git, chmod 600

# --- Solana ---
SOLANA_CLUSTER=devnet          # label only: devnet | mainnet-beta
SOLANA_RPC=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU   # Circle devnet USDC. Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SOLANA_PAYOUT_SECRET=          # REQUIRED. base58 secret key of the mint hot wallet (run: npm run keygen)
# SOLANA_MINT_ADDRESS=         # optional: defaults to the payout wallet, which then also receives deposits

# --- demo sellers + agent (apps/demo) ---
SELLER_PAYOUT_ADDRESS=         # Solana wallet that receives the demo sellers' USDC
AGENT_SOLANA_SECRET=           # funded wallet for `npm run demo:agent`

# --- EVM (optional): one deposit address for all EVM chains ---
EVM_MINT_ADDRESS=
EVM_ETHEREUM_RPC=https://ethereum-sepolia-rpc.publicnode.com
EVM_ETHEREUM_USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238     # Circle USDC on Sepolia
# Tempo testnet (Moderato) defaults are built in: chain 42431, rpc.moderato.tempo.xyz, pathUSD 0x20c0...0000.
# Get test pathUSD at the Tempo faucet. Override only if Tempo changes them.
# EVM_TEMPO_RPC=
# EVM_TEMPO_USDC=
# EVM_TEMPO_CHAIN_ID=
