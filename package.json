{
  "name": "ghosttab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private pay-per-call payments for AI agents over x402, using blind-signed credit.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx packages/server/src/index.ts",
    "demo:apis": "tsx apps/demo/src/apis.ts",
    "demo:agent": "tsx apps/demo/src/agent.ts",
    "build:web": "node web/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test packages/core/test/*.test.ts",
    "keygen": "tsx scripts/keygen.ts",
    "check": "tsx scripts/check.ts",
    "send": "tsx scripts/send.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "dotenv": "^16.4.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prasannaverse13/ghosttab.git"
  },
  "homepage": "https://ghosttab.onrender.com"
}
